diff --git a/clio/tasks/cut.py b/clio/tasks/cut.py
--- a/clio/tasks/cut.py
+++ b/clio/tasks/cut.py
@@ -170,14 +170,17 @@
     """Write *dest* via rename-backup → write → delete-backup; restore on failure.
 
     Matches product rule for re-cuts: keep old file until the new one succeeds.
+    An existing ``.clio_bak`` is the only good copy left by an interrupted re-cut,
+    so it is never overwritten: resolve it via the orphaned-backup restore flow.
     """
     dest = Path(dest)
     dest.parent.mkdir(parents=True, exist_ok=True)
     bak: Path | None = None
+    existing_bak = dest.with_name(dest.name + CUT_BAK_SUFFIX)
+    if existing_bak.exists():
+        raise CutBackupConflictError(t("task.cut.backup_conflict", {"path": existing_bak}))
     if dest.exists():
-        bak = dest.with_name(dest.name + ".clio_bak")
-        if bak.exists():
-            bak.unlink()
+        bak = existing_bak
         dest.replace(bak)
     try:
         write_fn(dest)
diff --git a/clio/tests/test_tasks_cut.py b/clio/tests/test_tasks_cut.py
--- a/clio/tests/test_tasks_cut.py
+++ b/clio/tests/test_tasks_cut.py
@@ -208,6 +208,22 @@
         assert dest.read_bytes() == b"new"
         assert not (tmp_path / "out.mp4.clio_bak").exists()
 
+    def test_existing_backup_is_never_overwritten(self, tmp_path):
+        from clio.tasks.cut import CutBackupConflictError, replace_file_safely
+
+        dest = tmp_path / "out.mp4"
+        dest.write_bytes(b"half-written")
+        bak = tmp_path / "out.mp4.clio_bak"
+        bak.write_bytes(b"last-good")
+        calls = []
+
+        with pytest.raises(CutBackupConflictError):
+            replace_file_safely(dest, calls.append)
+
+        assert calls == []
+        assert bak.read_bytes() == b"last-good"
+        assert dest.read_bytes() == b"half-written"
+
     def test_unlinks_partial_without_bak(self, tmp_path):
         from clio.tasks.cut import replace_file_safely
 
