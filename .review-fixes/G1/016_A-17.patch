     return "".join(character for character in normalized if character.isalnum())
 
 
+# Metadata keys whose values are file names / identifiers, not model-written content.
+_NON_CONTENT_KEYS = frozenset({"id", "index", "media_identity", "scope_id"})
+
+
+def _is_content_key(key: Any) -> bool:
+    name = str(key)
+    if name.startswith("_") or name in _NON_CONTENT_KEYS:
+        return False
+    return not name.endswith(("_file", "_path", "_stem"))
+
+
 def _searchable_text(value: Any) -> str:
+    """Join the model-written strings of *value* for fact matching.
+
+    Metadata such as ``source_file``, ``compressed_file``, ``media_identity``
+    and ``_lineage`` is skipped: a fact alias that merely appears in a file
+    name (e.g. "海边" in 海边日落.mp4) must not count as described.
+    """
     parts: list[str] = []
 
     def visit(item: Any) -> None:
         if isinstance(item, str):
             parts.append(item)
         elif isinstance(item, dict):
-            for nested in item.values():
-                visit(nested)
+            for key, nested in item.items():
+                if _is_content_key(key):
+                    visit(nested)
         elif isinstance(item, list):
             for nested in item:
                 visit(nested)
diff --git a/clio/tests/test_evaluation.py b/clio/tests/test_evaluation.py
--- a/clio/tests/test_evaluation.py
+++ b/clio/tests/test_evaluation.py
@@ -331,3 +331,25 @@
     assert "broken" in markdown
     assert "bad json" in markdown
     assert "gate failed" in markdown.lower()
+
+
+def test_fact_matching_ignores_file_names_and_metadata():
+    reference = _reference()
+    reference["required_facts"] = [
+        {"id": "lanterns", "description": "saw red lanterns", "aliases": ["lanterns"]},
+    ]
+    prediction = _prediction()
+    prediction["summary"] = "A quiet walk."
+    prediction["timeline"] = [{"start": "00:00", "end": "01:00", "description": "Walking"}]
+    prediction["highlights"] = []
+    prediction["title"] = "Morning"
+    prediction["source_file"] = "lanterns_night.mp4"
+    prediction["compressed_file"] = "001_lanterns_night.mp4"
+    prediction["media_identity"] = {"original_stem": "lanterns_night", "original_path": "D:/lanterns.mp4"}
+    prediction["_lineage"] = {"note": "lanterns"}
+    for key in ("location", "mood", "suggested_use"):
+        prediction[key] = ""
+
+    result = _score(prediction, reference)
+
+    assert result["metrics"]["facts"]["missing"] == ["lanterns"]
