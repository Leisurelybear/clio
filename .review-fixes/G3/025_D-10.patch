+def validate_project_yaml(
+    text: str,
+    project_dir: Path,
+    *,
+    config_path: str | Path = "config.yaml",
+) -> AppConfig:
+    """Validate candidate project.yaml *text* for *project_dir* without writing it.
+
+    Runs the same parsing and checks as ``load_config(config_path, project_dir)``
