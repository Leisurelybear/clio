diff --git a/packaging/build-desktop-macos.sh b/packaging/build-desktop-macos.sh
--- a/packaging/build-desktop-macos.sh
+++ b/packaging/build-desktop-macos.sh
@@ -6,8 +6,8 @@
 # Requires (installed automatically when missing):
 #   - a universal2 CPython 3.11 (e.g. python.org pkg), because PyInstaller's
 #     --target-architecture universal2 needs a universal2 interpreter
-#   - pyinstaller, pywebview, pyobjc-core and the pyobjc frameworks (Cocoa,
-#     WebKit, Quartz, Security)
+#   - pyinstaller, pywebview, keyring, pyobjc-core and the pyobjc frameworks
+#     (Cocoa, WebKit, Quartz, Security)
 #
 # Usage: bash packaging/build-desktop-macos.sh [--no-clean]
 set -euo pipefail
@@ -23,7 +23,9 @@
 
 PYTHON_BIN="${PYTHON_BIN:-python3}"
 
-"$PYTHON_BIN" -m pip install --quiet pyinstaller "pywebview" \
+# keyring==25.7.0 matches the Windows build and CI: without it the bundle has no
+# OS keyring backend and credentials silently fall back to a plaintext .env.
+"$PYTHON_BIN" -m pip install --quiet pyinstaller "pywebview" "keyring==25.7.0" \
     "pyobjc-core" "pyobjc-framework-Cocoa" "pyobjc-framework-WebKit" \
     "pyobjc-framework-Quartz" "pyobjc-framework-Security"
 
diff --git a/packaging/clio.spec b/packaging/clio.spec
--- a/packaging/clio.spec
+++ b/packaging/clio.spec
@@ -20,6 +20,13 @@
 from PyInstaller.utils.hooks import collect_submodules
 
 ROOT = Path(SPECPATH).parent.resolve()
+
+# collect_submodules("keyring") only warns when the package is missing, which
+# would ship a bundle that silently stores credentials in a plaintext .env.
+try:
+    import keyring  # noqa: F401
+except ImportError as exc:
+    raise SystemExit('keyring is required for the desktop build: pip install "keyring==25.7.0"') from exc
 
 IS_MAC = sys.platform == "darwin"
 
diff --git a/packaging/build-desktop.ps1 b/packaging/build-desktop.ps1
--- a/packaging/build-desktop.ps1
+++ b/packaging/build-desktop.ps1
@@ -9,11 +9,16 @@
 $root = Split-Path -Parent $PSScriptRoot
 Push-Location $root
 try {
+    # Prefer the project venv (where setup.ps1 installs dependencies) over PATH python.
+    $python = Join-Path $root ".venv\Scripts\python.exe"
+    if (-not (Test-Path $python)) {
+        $python = "python"
+    }
     $extra = @()
     if (-not $NoClean) {
         $extra += "--clean"
     }
-    python -m PyInstaller $extra packaging/clio.spec --noconfirm
+    & $python -m PyInstaller $extra packaging/clio.spec --noconfirm
     if ($LASTEXITCODE -ne 0) {
         throw "PyInstaller failed with exit code $LASTEXITCODE"
     }
