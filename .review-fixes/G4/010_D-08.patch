diff --git a/clio/ui/services/file_service.py b/clio/ui/services/file_service.py
--- a/clio/ui/services/file_service.py
+++ b/clio/ui/services/file_service.py
@@ -589,7 +589,9 @@
         else:
             start = int(start_s) if start_s else 0
             end = int(end_s) if end_s else size - 1
-        if start >= size or end >= size or start > end:
+        # RFC 7233 §2.1: a last-byte-pos past the end is clamped, not rejected.
+        end = min(end, size - 1)
+        if start >= size or start > end:
             _send_range_not_satisfiable(handler, size)
             return
         length = end - start + 1
diff --git a/clio/tests/test_send_video_range.py b/clio/tests/test_send_video_range.py
--- a/clio/tests/test_send_video_range.py
+++ b/clio/tests/test_send_video_range.py
@@ -82,3 +82,13 @@
         h = _handler()
         send_video_range(h, video)
         assert h._http_response_bytes == video.stat().st_size
+
+    def test_end_past_eof_is_clamped_to_206(self, video: Path):
+        h = _handler(range_hdr="bytes=0-100")
+        send_video_range(h, video)
+        assert h.send_response.call_args[0][0] == 206
+        headers = {c.args[0]: c.args[1] for c in h.send_header.call_args_list}
+        assert headers.get("Content-Range") == "bytes 0-15/16"
+        assert headers.get("Content-Length") == "16"
+        written = b"".join(c.args[0] for c in h.wfile.write.call_args_list)
+        assert written == b"0123456789ABCDEF"
