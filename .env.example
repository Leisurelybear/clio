# 复制为 .env 并填入真实值

# Google Gemini（video_analyze 默认需要）
GEMINI_API_KEY=your_api_key_here

# OpenAI（可选，用于 voiceover / vlog_plan）
# OPENAI_API_KEY=sk-...

# DeepSeek 等 OpenAI 兼容 API（可选）
# DEEPSEEK_API_KEY=sk-...

# 云端 ASR（可选，whisper.engine 设为对应 provider id 时使用）
# DASHSCOPE_API_KEY=sk-...
# BAIDU_APP_KEY=your_app_key
# BAIDU_SECRET_KEY=your_secret_key
